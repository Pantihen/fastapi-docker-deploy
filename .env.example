# Секрет для подписи JWT (сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite:///./app.db

# Явный список разрешённых origin через запятую (wildcard "*" запрещён)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Ограничение частоты входа
LOGIN_RATE_LIMIT=5/minute

# Администратор, создаваемый при старте (если ещё не существует)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345

# Celery: брокер и хранилище результатов (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Сколько секунд «отправляется» письмо в фоновой задаче
EMAIL_SEND_DELAY_SECONDS=10
