# Переменные окружения для docker compose.
# Внутри Docker-сети сервисы доступны по ИМЕНАМ (db, redis), а не по localhost:
# localhost в контейнере app — это сам контейнер app.
# Значения ниже — только для локального запуска. На сервере задайте свои.

# --- PostgreSQL (используется и сервисом db, и приложением) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
DATABASE_URL=postgresql+psycopg://app:app_password@db:5432/app_db

# --- Redis (брокер и хранилище результатов Celery) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Приложение ---
SECRET_KEY=docker-local-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOGIN_RATE_LIMIT=5/minute
EMAIL_SEND_DELAY_SECONDS=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
